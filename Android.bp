cc_binary {
    name: "hwcrypt",

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wunused",
        "-Wno-unused-parameter",
    ],
    srcs: [
        "main.cpp",
    ],

    defaults: [
        "keystore2_use_latest_aidl_ndk_shared",
        "keymint_use_latest_hal_aidl_ndk_shared",
    ],

    shared_libs: [
        "libbinder",
        "libbinder_ndk",
        "libutils",
        "liblog",
        "libbase",
        "libcrypto",
    ],

    static_libs: [
        "libgflags",
        "libkeymint_support",
    ],

    vendor: true,
}
